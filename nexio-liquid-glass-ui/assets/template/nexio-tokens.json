    "fills": {
      "themeFill": { "dark": 0.45, "light": 0.55 },
      "barFill": { "dark": 0.45, "light": 0.55 },
      "customizeFill": { "dark": 0.55, "light": 0.65 }
    },
    "materialLevels": {
      "soft": { "blurDp": 6, "panelBlurDp": 12, "dialogBlurDp": 12, "alphaDropLight": 0.2, "alphaDropDark": 0.32, "refraction": true, "directionalLight": true },
